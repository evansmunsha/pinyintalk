generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  profileImageUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  proficiencyLevel  String        @default("beginner")
  preferredTopics   String[]      @default([])
  totalPracticeTime Int           @default(0)
  role               CommunityRole @default(beginner)
  nativeSpeaker      Boolean      @default(false)
  chatInvitesEnabled Boolean      @default(true)

  // Settings. Language is a variable so more languages can be added later.
  englishAfterChinese Boolean @default(true)
  explanationLanguage String  @default("en")
  isTeacher           Boolean @default(false)

  phrases                     Phrase[]
  meiUsage                    MeiUsage[]
  sessions                    Session[]
  answers                     Answer[]
  communityQuestions          CommunityQuestion[]
  following                   Follow[]                 @relation("Follower")
  followers                   Follow[]                 @relation("Following")
  sentMessages                DirectMessage[]          @relation("Sender")
  receivedMessages            DirectMessage[]          @relation("Recipient")
  sentInvites                 DirectMessageInvitation[] @relation("InvitationSender")
  receivedInvites             DirectMessageInvitation[] @relation("InvitationRecipient")
  blocksMade                  UserBlock[]              @relation("Blocker")
  blocksReceived              UserBlock[]              @relation("BlockedUser")
  reportsMade                 UserReport[]             @relation("ReportSender")
  reportsReceived             UserReport[]             @relation("ReportTarget")
  conversations               Conversation[]
  conversationTurns           ConversationTurn[]
  mistakeReports              MistakeReport[]
  teacherApplications         TeacherApplication[]     @relation("TeacherApplicant")
  reviewedTeacherApplications TeacherApplication[]     @relation("TeacherApplicationReviewer")
  teacherResponses            TeacherResponse[]        @relation("TeacherAuthoredResponses")
  ownedGroups                 CommunityGroup[]         @relation("CommunityGroupOwner")
  groupMemberships            CommunityGroupMember[]
  voiceFeedback               CommunityVoiceFeedback[]
  communityReports            CommunityContentReport[]

  @@index([email])
}

// A phrase the learner already knows. Everything shown in the UI is pinyin.
model Phrase {
  id           String   @id @default(cuid())
  userId       String
  pinyin       String
  meaning      String
  note         String?
  // Hidden Chinese text used ONLY for audio. Never render it in the UI.
  speechText   String?
  hintKey      String?
  createdAt    DateTime @default(now())
  nextReviewAt DateTime @default(now())
  intervalDays Int      @default(1)
  correctCount Int      @default(0)
  wrongCount   Int      @default(0)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, nextReviewAt])
}

// One row per user per day, used for the daily Mei message limit.
model MeiUsage {
  id     String @id @default(cuid())
  userId String
  day    String
  count  Int    @default(0)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day])
}

// ---------- Lessons ----------
// Chinese characters below are hidden data (audio, future features). Never render them in the UI.

model Lesson {
  id              String           @id @default(cuid())
  title           String
  titleEnglish    String?
  titleChinese    String?
  theme           String
  description     String
  level           String
  objectives      String[]
  vocabulary      Json
  dialogues       Json?
  order           Int              @default(0)
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  listeningDrills ListeningDrill[]
  sessions        Session[]

  @@index([theme, level])
  @@index([order])
}

// ---------- Practice sessions ----------

model Session {
  id                String    @id @default(cuid())
  userId            String
  lessonId          String?
  mode              String
  status            String    @default("active")
  startedAt         DateTime  @default(now())
  completedAt       DateTime?
  duration          Int?
  toneAccuracy      Float?    @default(0)
  messageCount      Int       @default(0)
  questionsAnswered Int       @default(0)
  correctAnswers    Int       @default(0)
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson            Lesson?   @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  messages          Message[]
  answers           Answer[]

  @@index([userId, status])
  @@index([lessonId])
  @@index([startedAt])
}

model Message {
  id           String   @id @default(cuid())
  sessionId    String
  role         String
  content      String
  pinyin       String?
  translation  String?
  audioUrl     String?
  toneFeedback Json?
  createdAt    DateTime @default(now())
  session      Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
}

// ---------- Listening drills ----------

model ListeningDrill {
  id               String     @id @default(cuid())
  lessonId         String?
  title            String
  titleEnglish     String?
  titleChinese     String?
  audioUrl         String?
  transcript       String
  transcriptPinyin String
  duration         Int        @default(0)
  waveformData     Json?
  level            String
  createdAt        DateTime   @default(now())
  lesson           Lesson?    @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  questions        Question[]

  @@index([lessonId])
  @@index([level])
}

model Question {
  id            String         @id @default(cuid())
  drillId       String
  text          String
  options       String[]
  correctAnswer Int
  order         Int            @default(0)
  drill         ListeningDrill @relation(fields: [drillId], references: [id], onDelete: Cascade)
  answers       Answer[]

  @@index([drillId, order])
}

model Answer {
  id             String   @id @default(cuid())
  sessionId      String
  questionId     String
  userId         String
  selectedOption Int
  isCorrect      Boolean
  answeredAt     DateTime @default(now())
  session        Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question       Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([questionId])
  @@index([userId])
}

// ---------- Community ----------

enum CommunityRole {
  beginner
  learner
  advanced
  teacher
}

enum TeacherApplicationStatus {
  pending
  approved
  rejected
}

enum VoiceFeedbackRating {
  sounds_native
  almost_there
  needs_practice
}

enum CommunityContentReportStatus {
  open
  fixed
  rejected
}

enum DirectMessageInvitationStatus {
  pending
  accepted
  declined
}

model CommunityQuestion {
  id             String                   @id @default(cuid())
  userId         String
  text           String
  meaning        String?
  voiceNoteUrl   String?
  level          String
  status         String                   @default("open")
  groupId        String?
  createdAt      DateTime                 @default(now())
  user           User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  responses      TeacherResponse[]
  group          CommunityGroup?          @relation(fields: [groupId], references: [id], onDelete: SetNull)
  voiceFeedback  CommunityVoiceFeedback[]
  contentReports CommunityContentReport[]

  @@index([level, status])
  @@index([createdAt])
  @@index([groupId, createdAt])
}

model TeacherResponse {
  id            String            @id @default(cuid())
  questionId    String
  teacherId     String?
  teacherName   String
  text          String
  voiceNoteUrl  String?
  examplePinyin String?
  createdAt     DateTime          @default(now())
  question      CommunityQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  teacher       User?             @relation("TeacherAuthoredResponses", fields: [teacherId], references: [id], onDelete: SetNull)

  @@index([questionId])
}

model TeacherApplication {
  id         String                   @id @default(cuid())
  userId     String
  note       String
  status     TeacherApplicationStatus @default(pending)
  createdAt  DateTime                 @default(now())
  reviewedAt DateTime?
  reviewerId String?
  user       User                     @relation("TeacherApplicant", fields: [userId], references: [id], onDelete: Cascade)
  reviewer   User?                    @relation("TeacherApplicationReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([userId, createdAt])
}

model CommunityGroup {
  id          String                 @id @default(cuid())
  name        String
  description String
  ownerId     String
  createdAt   DateTime               @default(now())
  owner       User                   @relation("CommunityGroupOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members     CommunityGroupMember[]
  posts       CommunityQuestion[]

  @@index([createdAt])
  @@index([ownerId])
}

model CommunityGroupMember {
  id        String         @id @default(cuid())
  groupId   String
  userId    String
  createdAt DateTime       @default(now())
  group     CommunityGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId, createdAt])
}

model CommunityVoiceFeedback {
  id         String              @id @default(cuid())
  questionId String
  userId     String
  rating     VoiceFeedbackRating
  comment    String?
  createdAt  DateTime            @default(now())
  question   CommunityQuestion   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([questionId, userId])
  @@index([questionId, rating])
}

model CommunityContentReport {
  id         String                       @id @default(cuid())
  questionId String
  reporterId String
  note       String?
  status     CommunityContentReportStatus @default(open)
  createdAt  DateTime                     @default(now())
  question   CommunityQuestion            @relation(fields: [questionId], references: [id], onDelete: Cascade)
  reporter   User                         @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@unique([questionId, reporterId])
  @@index([status, createdAt])
}

// ---------- Saved voice conversations ----------
// Audio files live in storage (see lib/storage.ts). The database keeps only their paths.

model Conversation {
  id        String             @id @default(cuid())
  userId    String
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  turns     ConversationTurn[]

  @@index([userId, updatedAt])
}

model ConversationTurn {
  id               String       @id @default(cuid())
  conversationId   String
  userId           String
  createdAt        DateTime     @default(now())
  learnerAudioPath String?
  heardPinyin      String
  heardEnglish     String
  replyPinyin      String
  replyEnglish     String
  // Hidden Chinese text used only to make audio. Never render it.
  replySpeech      String?
  replyZhAudioPath String?
  replyEnAudioPath String?
  conversation     Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([userId])
}

enum SpeechClipStatus {
  generating
  ready
  failed
}

model SpeechClip {
  id        String           @id @default(cuid())
  cacheKey  String           @unique
  text      String
  lang      String
  audioPath String?
  status    SpeechClipStatus @default(generating)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([status, updatedAt])
}

model GeminiVoiceUsage {
  day       String   @id
  count     Int      @default(0)
  updatedAt DateTime @updatedAt
}

// ---------- Social ----------

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User     @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId])
}

model DirectMessage {
  id           String    @id @default(cuid())
  senderId     String
  recipientId  String
  text         String
  voiceNoteUrl String?
  readAt       DateTime?
  createdAt    DateTime  @default(now())
  sender       User      @relation("Sender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient    User      @relation("Recipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([senderId, recipientId, createdAt])
  @@index([recipientId, readAt])
}

model DirectMessageInvitation {
  id         String                        @id @default(cuid())
  senderId   String
  recipientId String
  message    String
  status     DirectMessageInvitationStatus @default(pending)
  createdAt  DateTime                      @default(now())
  updatedAt  DateTime                      @updatedAt
  sender     User                          @relation("InvitationSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient  User                          @relation("InvitationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@unique([senderId, recipientId, status])
  @@index([recipientId, status, createdAt])
  @@index([senderId, createdAt])
}

model UserBlock {
  id          String   @id @default(cuid())
  blockerId   String
  blockedId   String
  createdAt   DateTime @default(now())
  blocker     User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedUser User     @relation("BlockedUser", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

model UserReport {
  id            String   @id @default(cuid())
  reporterId    String
  reportedUserId String
  note          String
  status        String   @default("open")
  createdAt     DateTime @default(now())
  reporter      User     @relation("ReportSender", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUser  User     @relation("ReportTarget", fields: [reportedUserId], references: [id], onDelete: Cascade)

  @@index([reportedUserId, status])
  @@index([reporterId, createdAt])
}

enum MistakeReportStatus {
  open
  fixed
  rejected
}

model MistakeReport {
  id        String              @id @default(cuid())
  userId    String
  exactText String
  page      String
  note      String
  status    MistakeReportStatus @default(open)
  createdAt DateTime            @default(now())
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([userId, createdAt])
}
