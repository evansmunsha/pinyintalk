generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  proficiencyLevel  String   @default("beginner")
  preferredTopics   String[] @default([])
  totalPracticeTime Int      @default(0)

  // Settings. Language is a variable so more languages can be added later.
  englishAfterChinese Boolean @default(true)
  explanationLanguage String  @default("en")
  isTeacher           Boolean @default(false)

  phrases            Phrase[]
  meiUsage           MeiUsage[]
  sessions           Session[]
  answers            Answer[]
  communityQuestions CommunityQuestion[]
  following          Follow[]            @relation("Follower")
  followers          Follow[]            @relation("Following")
  sentMessages       DirectMessage[]     @relation("Sender")
  receivedMessages   DirectMessage[]     @relation("Recipient")
  conversations       Conversation[]
  conversationTurns   ConversationTurn[]
  mistakeReports      MistakeReport[]

  @@index([email])
}

// A phrase the learner already knows. Everything shown in the UI is pinyin.
model Phrase {
  id           String   @id @default(cuid())
  userId       String
  pinyin       String
  meaning      String
  note         String?
  // Hidden Chinese text used ONLY for audio. Never render it in the UI.
  speechText   String?
  hintKey      String?
  createdAt    DateTime @default(now())
  nextReviewAt DateTime @default(now())
  intervalDays Int      @default(1)
  correctCount Int      @default(0)
  wrongCount   Int      @default(0)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, nextReviewAt])
}

// One row per user per day, used for the daily Mei message limit.
model MeiUsage {
  id     String @id @default(cuid())
  userId String
  day    String
  count  Int    @default(0)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day])
}

// ---------- Lessons ----------
// Chinese characters below are hidden data (audio, future features). Never render them in the UI.

model Lesson {
  id              String           @id @default(cuid())
  title           String
  titleEnglish    String?
  titleChinese    String?
  theme           String
  description     String
  level           String
  objectives      String[]
  vocabulary      Json
  dialogues       Json?
  order           Int              @default(0)
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  listeningDrills ListeningDrill[]
  sessions        Session[]

  @@index([theme, level])
  @@index([order])
}

// ---------- Practice sessions ----------

model Session {
  id                String    @id @default(cuid())
  userId            String
  lessonId          String?
  mode              String
  status            String    @default("active")
  startedAt         DateTime  @default(now())
  completedAt       DateTime?
  duration          Int?
  toneAccuracy      Float?    @default(0)
  messageCount      Int       @default(0)
  questionsAnswered Int       @default(0)
  correctAnswers    Int       @default(0)
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson            Lesson?   @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  messages          Message[]
  answers           Answer[]

  @@index([userId, status])
  @@index([lessonId])
  @@index([startedAt])
}

model Message {
  id           String   @id @default(cuid())
  sessionId    String
  role         String
  content      String
  pinyin       String?
  translation  String?
  audioUrl     String?
  toneFeedback Json?
  createdAt    DateTime @default(now())
  session      Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
}

// ---------- Listening drills ----------

model ListeningDrill {
  id               String     @id @default(cuid())
  lessonId         String?
  title            String
  titleEnglish     String?
  titleChinese     String?
  audioUrl         String?
  transcript       String
  transcriptPinyin String
  duration         Int        @default(0)
  waveformData     Json?
  level            String
  createdAt        DateTime   @default(now())
  lesson           Lesson?    @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  questions        Question[]

  @@index([lessonId])
  @@index([level])
}

model Question {
  id            String         @id @default(cuid())
  drillId       String
  text          String
  options       String[]
  correctAnswer Int
  order         Int            @default(0)
  drill         ListeningDrill @relation(fields: [drillId], references: [id], onDelete: Cascade)
  answers       Answer[]

  @@index([drillId, order])
}

model Answer {
  id             String   @id @default(cuid())
  sessionId      String
  questionId     String
  userId         String
  selectedOption Int
  isCorrect      Boolean
  answeredAt     DateTime @default(now())
  session        Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question       Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([questionId])
  @@index([userId])
}

// ---------- Community ----------

model CommunityQuestion {
  id           String            @id @default(cuid())
  userId       String
  text         String
  voiceNoteUrl String?
  level        String
  status       String            @default("open")
  createdAt    DateTime          @default(now())
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  responses    TeacherResponse[]

  @@index([level, status])
  @@index([createdAt])
}

model TeacherResponse {
  id            String            @id @default(cuid())
  questionId    String
  teacherName   String
  text          String
  voiceNoteUrl  String?
  examplePinyin String?
  createdAt     DateTime          @default(now())
  question      CommunityQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
}

// ---------- Saved voice conversations ----------
// Audio files live in storage (see lib/storage.ts). The database keeps only their paths.

model Conversation {
  id        String             @id @default(cuid())
  userId    String
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  turns     ConversationTurn[]

  @@index([userId, updatedAt])
}

model ConversationTurn {
  id               String       @id @default(cuid())
  conversationId   String
  userId           String
  createdAt        DateTime     @default(now())
  learnerAudioPath String?
  heardPinyin      String
  heardEnglish     String
  replyPinyin      String
  replyEnglish     String
  // Hidden Chinese text used only to make audio. Never render it.
  replySpeech      String?
  replyZhAudioPath String?
  replyEnAudioPath String?
  conversation     Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([userId])
}

// ---------- Social ----------

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User     @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId])
}

model DirectMessage {
  id           String    @id @default(cuid())
  senderId     String
  recipientId  String
  text         String
  voiceNoteUrl String?
  readAt       DateTime?
  createdAt    DateTime  @default(now())
  sender       User      @relation("Sender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient    User      @relation("Recipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([senderId, recipientId, createdAt])
  @@index([recipientId, readAt])
}

enum MistakeReportStatus {
  open
  fixed
  rejected
}

model MistakeReport {
  id        String              @id @default(cuid())
  userId    String
  exactText String
  page      String
  note      String
  status    MistakeReportStatus @default(open)
  createdAt DateTime            @default(now())
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([userId, createdAt])
}
